# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
# In production these are `wrangler secret put`, not vars.
SESSION_SECRET=
# Optional. Without it, items no rule recognises stay uncategorized.
ANTHROPIC_API_KEY=
# Optional, legacy: only for the first sign-in as `owner` after migration 005.
OWNER_PASSWORD_HASH=
