{
  "name": "invoice-gang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "db:apply": "wrangler d1 execute invoice-gang --file=./src/db/schema.sql",
    "db:apply:local": "wrangler d1 execute invoice-gang --local --file=./src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute invoice-gang --local --file=./src/db/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.130.0"
  }
}
